# Copy to .env.local for development. Never commit real values.

# --- /admin access -----------------------------------------------------------
# Both must be set or /admin refuses to open at all.

# The shared password for the company-details editor.
ADMIN_PASSWORD=

# Random 32+ character string used to sign the admin session cookie.
# Generate one with:  openssl rand -base64 32
ADMIN_SESSION_SECRET=

# --- Where admin edits are stored --------------------------------------------
# Vercel's filesystem is read-only at runtime, so production needs a real store.
# Add the KV (Upstash) integration in the Vercel dashboard and it sets these for
# you. Leave them blank locally: edits then fall back to the gitignored file
# data/company-overrides.json.

KV_REST_API_URL=
KV_REST_API_TOKEN=

# --- Enquiry form email (Google Workspace SMTP) -----------------------------
# The contact form emails enquiries through info@aayuexim.com's Gmail.
# SMTP_PASS must be a Google *App Password* (16 characters), never the normal
# account password: Google Account → Security → 2-Step Verification (must be
# on) → App passwords. Without SMTP_USER + SMTP_PASS the form fails closed in
# production (shows an error) and only logs in development.

SMTP_USER=info@aayuexim.com
SMTP_PASS=
# Optional — where enquiries are delivered. Defaults to SMTP_USER.
ENQUIRY_TO=
# Optional — defaults shown; only change for a non-Google provider.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
